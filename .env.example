# Puertos publicados en el host (mapeo host -> contenedor)
BACKEND_PORT=4001
FRONTEND_PORT=3000

# Puerto HTTP dentro del contenedor del backend (debe coincidir con EXPOSE del Dockerfile)
BACKEND_INTERNAL_PORT=4001

# URL del API/socket.io tal como la ve el NAVEGADOR (no uses el nombre del servicio Docker).
# Si cambias BACKEND_PORT, actualiza también el puerto aquí (ej: http://localhost:5001).
VITE_BACKEND_URL=http://localhost:4001
